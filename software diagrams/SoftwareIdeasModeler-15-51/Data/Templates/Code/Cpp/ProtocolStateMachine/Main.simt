<sim-template version="1.0">
  <meta>
    <name>ProtocolStateMachine</name>
    <description></description>
    <type>SourceCode</type>
    <language>Cpp</language>
  </meta>
  <files defaultName="{Name}.cpp">
    <file name="State.cpp" outputName="{Element.Name}.cpp" type="AbstractElement">
      <settings>
        <setting name="DefaultType" value="object"></setting>
        <setting name="NameAdjustment" value="CamelCase"></setting>
      </settings>
      <types>
        <type name="state" />        
        <type name="final-state" />
      </types>
    </file>
    <file name="State.h" outputName="{Element.Name}.h" type="AbstractElement">
      <settings>
        <setting name="DefaultType" value="object"></setting>
        <setting name="NameAdjustment" value="CamelCase"></setting>
      </settings>
      <types>
        <type name="state" />
        <type name="final-state" />
      </types>
    </file>
    <file name="BaseState.cpp" outputName="{Diagram.Name}_BaseState.cpp" type="Diagram">
      <settings>
        <setting name="DefaultType" value="object"></setting>
        <setting name="NameAdjustment" value="CamelCase"></setting>
      </settings>
    </file>
    <file name="Context.h" outputName="{Diagram.Name}_Context.h" type="Diagram">
      <settings>
        <setting name="DefaultType" value="object"></setting>
        <setting name="NameAdjustment" value="CamelCase"></setting>
      </settings>
    </file>
    <file name="Context.cpp" outputName="{Diagram.Name}_Context.cpp" type="Diagram">
      <settings>
        <setting name="DefaultType" value="object"></setting>
        <setting name="NameAdjustment" value="CamelCase"></setting>
      </settings>
    </file>
  </files>
</sim-template>